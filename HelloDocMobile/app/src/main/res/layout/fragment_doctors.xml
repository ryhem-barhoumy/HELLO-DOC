<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/hd_background" android:paddingHorizontal="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/doctors_le_bon_medecin_au_bon_moment" style="@style/HdTitle" android:layout_marginTop="5dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/doctors_recherchez_par_nom_specialite_ou_ville_e" style="@style/HdCaption" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/hd_white" app:cardElevation="1dp" app:strokeColor="@color/hd_line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/queryLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/doctors_nom_du_medecin_ou_mot_cle" android:layout_marginBottom="11dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/cityLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/doctors_ville" android:layout_marginBottom="11dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords"/>
      </com.google.android.material.textfield.TextInputLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/doctors_specialite" android:textSize="13sp" android:textColor="@color/hd_muted" android:layout_marginBottom="6dp"/>
      <Spinner android:id="@+id/spinnerSpecialty" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_filter" android:paddingHorizontal="12dp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDate" style="@style/HdOutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/doctors_choisir_une_date"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="7dp" android:text="@string/doctors_effacer" android:textAllCaps="false"/>
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="15dp" android:layout_marginBottom="8dp" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/doctors_medecins" android:textSize="19sp" android:textColor="@color/hd_text" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/hd_blue" android:textSize="12sp"/>
  </LinearLayout>
  <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>
  <TextView android:id="@+id/tvMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:textSize="14sp" android:textColor="@color/hd_muted" android:gravity="center" android:visibility="gone"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDoctors" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="18dp"/>
</LinearLayout>
