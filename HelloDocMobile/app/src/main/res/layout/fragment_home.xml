<?xml version='1.0' encoding='UTF-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hd_home_background">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="19dp" android:paddingBottom="104dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_hello" android:textColor="@color/hd_green" android:letterSpacing="0.08" android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_welcome" android:textColor="@color/hd_text" android:textSize="27sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/home_intro" android:textColor="@color/hd_muted" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="385dp" android:layout_marginTop="23dp" android:background="@drawable/bg_home_aura">
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="239dp" android:layout_gravity="center" android:layout_marginLeft="26dp" android:layout_marginRight="26dp" app:cardCornerRadius="31dp" app:cardBackgroundColor="@color/hd_white" app:cardElevation="4dp" app:strokeColor="@color/hd_home_line" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="16dp">
          <ImageView android:layout_width="87dp" android:layout_height="87dp" android:background="@drawable/bg_home_cross" android:src="@drawable/ic_medical_cross" android:padding="22dp" android:contentDescription="@string/home_health_centre"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:gravity="center" android:text="@string/home_health_centre" android:textColor="@color/hd_text" android:textSize="19sp" android:fontFamily="sans-serif-medium"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/home_subheading" android:textColor="@color/hd_muted" android:textSize="13sp"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginTop="26dp" app:cardCornerRadius="17dp" app:cardElevation="6dp" app:cardBackgroundColor="@color/hd_white">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="13dp" android:orientation="horizontal">
          <TextView android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_home_cross" android:gravity="center" android:text="◷" android:textColor="@color/hd_green" android:textSize="22sp"/>
          <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_simple" android:fontFamily="sans-serif-medium" android:textColor="@color/hd_text" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_choose_slot" android:textColor="@color/hd_muted" android:textSize="11sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginBottom="22dp" app:cardCornerRadius="17dp" app:cardElevation="6dp" app:cardBackgroundColor="@color/hd_white">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="13dp" android:orientation="horizontal">
          <TextView android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_home_cross" android:gravity="center" android:text="♡" android:textColor="@color/hd_green" android:textSize="24sp"/>
          <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_followup" android:fontFamily="sans-serif-medium" android:textColor="@color/hd_text" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_appointments_hint" android:textColor="@color/hd_muted" android:textSize="11sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/home_tagline" android:textColor="@color/hd_green" android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/home_footer" android:textColor="@color/hd_muted" android:textSize="12sp"/>
  </LinearLayout>
</ScrollView>

<!-- Bouton de recherche fixe, comme le bouton + du TP, visible pendant le défilement. -->
<com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/fabSearchDoctor"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="24dp"
    android:contentDescription="@string/home_search_button_desc"
    app:backgroundTint="@color/hd_green"
    app:srcCompat="@drawable/ic_search"
    app:tint="@color/hd_white"
    app:fabSize="normal"
    app:elevation="8dp" />
</FrameLayout>
