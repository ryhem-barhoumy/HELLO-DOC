<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hd_background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_mon_espace_personnel" style="@style/HdTitle" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_gardez_vos_coordonnees_a_jour" style="@style/HdCaption" android:layout_marginTop="5dp" android:layout_marginBottom="6dp"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/hd_white" app:cardElevation="1dp" app:strokeColor="@color/hd_line" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
          <ImageView android:id="@+id/imgPhoto" android:layout_width="92dp" android:layout_height="92dp" android:background="@drawable/bg_avatar" android:padding="9dp" android:src="@drawable/medical_symbol" android:contentDescription="@string/profile_photo_du_patient" android:scaleType="centerCrop"/>
          <TextView android:id="@+id/tvName" style="@style/HdTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="@string/profile_mon_profil"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/profile_patient_hello_doc" android:textColor="@color/hd_green" android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePhoto" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="46dp" android:text="@string/profile_modifier_la_photo" android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeletePhoto" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="46dp" android:text="@string/profile_supprimer" android:textColor="@color/hd_error" android:textAllCaps="false"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/hd_white" app:cardElevation="1dp" app:strokeColor="@color/hd_line" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_mes_informations" style="@style/HdSubtitle" android:layout_marginBottom="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/profileFirstLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_prenom" android:layout_marginBottom="11dp">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFirstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/profileLastLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_nom" android:layout_marginBottom="11dp">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/profileEmailLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_e_mail_non_modifiable" android:layout_marginBottom="11dp">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/profilePhoneLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_telephone" android:layout_marginBottom="11dp">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/profileAddressLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_adresse" android:layout_marginBottom="11dp">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/profilePasswordLayout" style="@style/HdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_mot_de_passe_actuel_pour_confirmer" android:layout_marginBottom="11dp" app:endIconMode="password_toggle">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/tvError" android:textColor="@color/hd_error" android:visibility="gone" android:layout_marginTop="3dp"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="@style/HdButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="@string/profile_enregistrer_mes_modifications"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/hd_white" app:cardElevation="1dp" app:strokeColor="@color/hd_line" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_security" style="@style/HdSubtitle"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/profile_security_hint" style="@style/HdCaption"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePassword" style="@style/HdOutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:text="@string/password_change_title" app:icon="@drawable/ic_profile" app:iconTint="@color/hd_green"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" style="@style/HdOutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/profile_se_deconnecter" android:textColor="@color/hd_error"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_vos_informations_restent_accessibles_uni" style="@style/HdCaption" android:layout_marginTop="14dp" android:layout_marginBottom="23dp" android:gravity="center"/>
  </LinearLayout>
</ScrollView>
