<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient android:startColor="#F2FAF6" android:centerColor="#E7F5EE" android:endColor="#F3F9F7" android:angle="90" />
        </shape>
    </item>
    <item android:left="26dp" android:right="26dp" android:top="15dp" android:bottom="15dp">
        <shape android:shape="oval"><solid android:color="#DDF1E7" /><stroke android:width="1dp" android:color="#CBE8DC" /></shape>
    </item>
    <item android:left="60dp" android:right="60dp" android:top="47dp" android:bottom="46dp">
        <shape android:shape="oval"><solid android:color="#EAF7F1"/><stroke android:width="1dp" android:color="#B9E4D5" /></shape>
    </item>
</layer-list>
