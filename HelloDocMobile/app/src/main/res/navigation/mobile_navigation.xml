<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/homeFragment">

    <fragment android:id="@+id/homeFragment"
        android:name="com.example.hellodoc.ui.HomeFragment"
        android:label="@string/nav_home">
        <action android:id="@+id/action_home_to_doctors" app:destination="@id/doctorsFragment" />
        <action android:id="@+id/action_home_to_appointments" app:destination="@id/appointmentsFragment" />
    </fragment>

    <fragment android:id="@+id/doctorsFragment"
        android:name="com.example.hellodoc.ui.DoctorsFragment"
        android:label="@string/nav_doctors">
        <action android:id="@+id/action_doctorsFragment_to_doctorDetailsFragment" app:destination="@id/doctorDetailsFragment" />
    </fragment>

    <fragment android:id="@+id/doctorDetailsFragment"
        android:name="com.example.hellodoc.ui.DoctorDetailsFragment"
        android:label="@string/doctor_details_profil_du_medecin">
        <argument android:name="doctorId" app:argType="string" />
    </fragment>

    <fragment android:id="@+id/appointmentsFragment"
        android:name="com.example.hellodoc.ui.AppointmentsFragment"
        android:label="@string/nav_appointments" />

    <fragment android:id="@+id/profileFragment"
        android:name="com.example.hellodoc.ui.ProfileFragment"
        android:label="@string/nav_profile" />
</navigation>
