<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HelloDoc" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hd_blue</item>
        <item name="colorOnPrimary">@color/hd_white</item>
        <item name="colorSecondary">@color/hd_teal</item>
        <item name="colorSurface">@color/hd_white</item>
        <item name="colorOnSurface">@color/hd_text</item>
        <item name="android:statusBarColor">@color/hd_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/hd_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="HdTitle">
        <item name="android:textColor">@color/hd_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="HdSubtitle">
        <item name="android:textColor">@color/hd_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="HdCaption">
        <item name="android:textColor">@color/hd_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="HdInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/hd_blue</item>
        <item name="boxBackgroundColor">@color/hd_white</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="HdButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/hd_blue</item>
    </style>
    <style name="HdOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>