<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application android:name=".HelloDocApp" android:allowBackup="false"
        android:label="Hello Doc"
        android:icon="@mipmap/ic_launcher" android:theme="@style/Theme.HelloDoc"
        android:supportsRtl="true">
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LoginActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
