<resources>
    <style name="AuthTitle">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">serif</item><item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item><item name="android:textSize">32sp</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="AuthHelp">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item><item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">4dp</item><item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="AuthLabel" parent="AuthHelp">
        <item name="android:textStyle">bold</item><item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">24dp</item><item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">8dp</item><item name="android:letterSpacing">0.06</item>
    </style>
    <style name="Eyebrow" parent="AuthLabel">
        <item name="android:textColor">@color/brand</item><item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="AuthButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:layout_marginTop">12dp</item>
        <item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item><item name="android:paddingTop">14dp</item><item name="android:paddingBottom">14dp</item>
    </style>
    <style name="OutlineButton" parent="AuthButton">
        <item name="backgroundTint">@android:color/transparent</item><item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item><item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextButton" parent="OutlineButton"><item name="strokeWidth">0dp</item></style>
    <style name="AuthField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item><item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item><item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item><item name="boxBackgroundColor">@color/white</item>
    </style>
    <style name="AuthError" parent="AuthHelp">
        <item name="android:textColor">@color/error</item><item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:background">@drawable/bg_error</item><item name="android:padding">14dp</item>
    </style>
    <style name="RoleChoice" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item><item name="android:minHeight">56dp</item>
        <item name="android:padding">10dp</item><item name="android:background">@drawable/role_choice</item>
        <item name="android:textColor">@color/ink</item><item name="android:textStyle">bold</item>
    </style>
</resources>
