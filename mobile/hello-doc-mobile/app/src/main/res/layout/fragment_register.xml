    </com.google.android.material.textfield.TextInputLayout><TextView style="@style/Eyebrow" android:text="@string/register_security" /><com.google.android.material.textfield.TextInputLayout style="@style/AuthField" android:hint="@string/auth_adresse_e_mail"  >
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textEmailAddress" android:maxLength="254" android:singleLine="true" android:textSize="16sp" android:textColor="@color/ink" android:autofillHints="emailAddress"/>
