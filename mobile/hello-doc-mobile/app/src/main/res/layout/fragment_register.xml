    </com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/btnDocument" style="@style/OutlineButton" android:text="@string/auth_joindre_mon_attestation_a_lordre" /><TextView android:id="@+id/tvDocument" style="@style/AuthHelp" android:text="@string/auth_aucun_justificatif_selectionne" android:accessibilityLiveRegion="polite"/><TextView style="@style/AuthHelp" android:text="@string/auth_un_fichier_pdf_jpeg_ou_png_de_5_mo_maximum" /></LinearLayout><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbConsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="24dp" android:text="@string/register_consent" android:textSize="14sp" android:textColor="@color/muted"/><TextView android:id="@+id/tvError" style="@style/AuthError" android:visibility="gone"/><ProgressBar android:id="@+id/progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:visibility="gone" android:contentDescription="@string/loading"/><com.google.android.material.button.MaterialButton android:id="@+id/btnRegister" style="@style/AuthButton" android:text="@string/auth_creer_mon_compte" /><com.google.android.material.button.MaterialButton android:id="@+id/tvLogin" style="@style/TextButton" android:text="@string/auth_deja_inscrit_se_connecter" /></LinearLayout></ScrollView>
