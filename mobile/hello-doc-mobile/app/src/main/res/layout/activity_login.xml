<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding"><com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="@style/TextButton" android:layout_width="wrap_content" android:text="@string/back" app:icon="@drawable/ic_back" app:iconTint="@color/ink" android:layout_marginTop="0dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_brand" android:importantForAccessibility="no"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="@string/app_name" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/ink"/>
    </LinearLayout><TextView style="@style/Eyebrow" android:text="@string/login_eyebrow" /><TextView style="@style/AuthTitle" android:text="@string/login_title" /><TextView style="@style/AuthHelp" android:text="@string/login_help" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/bg_card"><com.google.android.material.textfield.TextInputLayout style="@style/AuthField" android:hint="@string/auth_adresse_e_mail" android:id="@+id/emailLayout" >
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textEmailAddress" android:maxLength="254" android:singleLine="true" android:textSize="16sp" android:textColor="@color/ink" android:autofillHints="emailAddress" android:imeOptions="actionNext"/>
    </com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout style="@style/AuthField" android:hint="@string/auth_mot_de_passe" android:id="@+id/passwordLayout" app:endIconMode="password_toggle">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLength="72" android:singleLine="true" android:textSize="16sp" android:textColor="@color/ink" android:saveEnabled="false" android:autofillHints="password" android:imeOptions="actionDone"/>
    </com.google.android.material.textfield.TextInputLayout><TextView android:id="@+id/tvNotice" style="@style/AuthHelp" android:background="@drawable/bg_badge" android:padding="14dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/><TextView android:id="@+id/tvError" style="@style/AuthError" android:visibility="gone"/><ProgressBar android:id="@+id/progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:visibility="gone" android:contentDescription="@string/loading"/><com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" style="@style/AuthButton" android:text="@string/home_login" /><TextView style="@style/AuthHelp" android:text="@string/login_security" android:gravity="center" android:textSize="12sp"/></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/tvRegister" style="@style/TextButton" android:text="@string/login_register" /><TextView style="@style/AuthHelp" android:text="@string/home_footer" android:gravity="center" android:textSize="12sp" android:layout_marginTop="24dp"/></LinearLayout></ScrollView>
