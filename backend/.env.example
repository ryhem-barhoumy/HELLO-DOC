# Copy to .env.local and fill in values for your own computer.
# This example contains no personal host, port, username, or credentials.
HELLODOC_DB_HOST=
HELLODOC_DB_PORT=
HELLODOC_DB_NAME=hello_doc
HELLODOC_DB_USERNAME=
# Leave empty for a MySQL account configured without a password.
HELLODOC_DB_PASSWORD=
LARAGON_ROOT=
# The local startup script prompts for this separately when it is unset/blank.
HELLODOC_ADMIN_INITIAL_PASSWORD=
# Spring Boot API port shared by this project.
SERVER_PORT=8081
HELLODOC_EMAIL_ENABLED=false
